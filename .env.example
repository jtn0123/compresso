# Example environment configuration for Compresso.
#
# Copy to `.env` and adjust. `.env` is gitignored -- never commit a filled-in
# copy. Nothing in this repo auto-loads a `.env` file today; these are the
# variables the code reads from the process environment, collected in one place
# so you know what is available to export or to pass through docker-compose.
#
# The frontend dev server has its own copy of the backend-URL setting at
# compresso/webserver/frontend/.env.example -- the value below is the same one.


# --- Application ---------------------------------------------------------

# Root directory for Compresso's config, database and logs.
# Read by compresso/libs/common.py; defaults to the user's home directory.
# HOME_DIR=/config

# Comma-separated plugin IDs that are allowed to run even though they are not
# in the first-party plugin set. Read by compresso/libs/unplugins/executor.py.
# Leave empty unless you have audited the plugin yourself -- this is a
# deliberate escape hatch from the plugin allowlist, so every ID added here is
# code you are choosing to trust.
# COMPRESSO_TRUSTED_PLUGIN_IDS=


# --- Frontend dev server -------------------------------------------------

# Backend the Quasar dev server proxies to. Read by
# compresso/webserver/frontend/quasar.config.js.
COMPRESSO_BACKEND_URL=http://localhost:8888


# --- Live end-to-end tests -----------------------------------------------
# Read by compresso/webserver/frontend/playwright.live.config.js.

# BACKEND_PORT=8920
# PYTHON_BIN=python3.13
